# ---------------------------------------------------------------------------
# pnpm security hardening
# ---------------------------------------------------------------------------

# Reject package versions published less than 1 day ago.
# Guards against typosquatting / dependency-confusion attacks that race to
# publish a malicious version before legitimate maintainers notice.
minimum-dep-age=86400

# Verify every file extracted from the content-addressed store matches its
# recorded checksum. Detects store corruption or tampering.
verify-store-integrity=true

# Abort on TLS certificate errors. Never disable in CI or production.
strict-ssl=true

# Prefer the existing lockfile; fail rather than silently mutating it.
# Override explicitly with --no-frozen-lockfile when intentionally updating.
prefer-frozen-lockfile=true

# Do NOT hoist packages to the root node_modules. Each package may only
# import what it explicitly declares, preventing phantom-dependency bugs
# and restricting the blast radius of a compromised transitive dep.
shamefully-hoist=false

# Fail the install when a peer dependency is missing or mismatched.
# Surfaces hidden compatibility issues early rather than at runtime.
strict-peer-dependencies=true
