# ---------------------------------------------------------------------------
# pnpm security hardening
# ---------------------------------------------------------------------------
# NOTE (verified 2026-10-03 on pnpm 11.8.0): pnpm 11 reads its own settings only from pnpm-workspace.yaml;
# `pnpm config get` returns undefined for every key below, so they do NOT take effect from this file. Most equal
# pnpm's defaults (strict-ssl, verify-store-integrity, shamefully-hoist=false). The settings that must be
# enforced belong in pnpm-workspace.yaml (see minimumReleaseAge there). strict-peer-dependencies is unverified:
# if you want it enforced, add `strictPeerDependencies: true` to pnpm-workspace.yaml and run an install.

# Reject package versions published less than 1 day ago: MOVED to pnpm-workspace.yaml (`minimumReleaseAge: 1440`).
# The line that used to be here, `minimum-dep-age=86400`, is not a pnpm setting and never did anything.

# Verify every file extracted from the content-addressed store matches its
# recorded checksum. Detects store corruption or tampering.
verify-store-integrity=true

# Abort on TLS certificate errors. Never disable in CI or production.
strict-ssl=true

# Prefer the existing lockfile; fail rather than silently mutating it.
# Override explicitly with --no-frozen-lockfile when intentionally updating.
prefer-frozen-lockfile=true

# Do NOT hoist packages to the root node_modules. Each package may only
# import what it explicitly declares, preventing phantom-dependency bugs
# and restricting the blast radius of a compromised transitive dep.
shamefully-hoist=false

# Fail the install when a peer dependency is missing or mismatched.
# Surfaces hidden compatibility issues early rather than at runtime.
strict-peer-dependencies=true
