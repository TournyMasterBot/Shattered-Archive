{
  "name": "shatteredarchive",
  "version": "1.0.0",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "build": "tsc",
    "clean": "tsc --build --clean",
    "start": "concurrently \"npm run start:web:dev\" \"npm run start:game-server:dev\" \"npm run start:game-client:dev\"",
    "start:prod": "concurrently \"npm run start:web:prod\" \"npm run start:game-server:prod\" \"npm run start:game-client:prod\"",
    "start:web:dev": "npx nodemon --exec ts-node src/server-web/app.ts dev",
    "start:web:prod": "npx nodemon --exec ts-node src/server-web/app.ts prod",
    "start:game-server:dev": "npx nodemon --exec ts-node src/server-game/app.ts dev",
    "start:game-server:prod": "npx nodemon --exec ts-node src/server-game/app.ts prod",
    "start:game-client:dev": "npx nodemon --exec ts-node src/game-client/app.ts dev",
    "start:game-client:prod": "npx nodemon --exec ts-node src/game-client/app.ts prod",
    "test": "npx jest --config jest.config.js"
  },
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "concurrently": "^9.1.2",
    "nodemon": "^3.1.9",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5"
  }
}
