{
  "name": "shatteredarchive",
  "version": "1.0.0",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "build": "tsc",
    "clean": "tsc --build --clean",
    "start": "concurrently \"npm run start:web:dev\" \"npm run start:game-server:dev\" \"npm run start:game-client:dev\"",
    "start:prod": "concurrently \"npm run start:web:prod\" \"npm run start:game-server:prod\" \"npm run start:game-client:prod\"",
    "start:web:dev": "npm --prefix ./src/server-web run start:dev",
    "start:web:prod": "npm --prefix ./src/server-web run start:prod",
    "start:game-server:dev": "npm --prefix ./src/server-game run start:dev",
    "start:game-server:prod": "npm --prefix ./src/server-game run start:prod",
    "start:game-client:dev": "npm --prefix ./src/game-client run start:dev",
    "start:game-client:prod": "npm --prefix ./src/game-client run start:prod",
    "test": "npx jest --config jest.config.js"
  },
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.0.8",
    "concurrently": "^9.1.2",
    "nodemon": "^3.1.9",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5"
  }
}
