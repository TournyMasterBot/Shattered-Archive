{
  "name": "shatteredarchive",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "tsc -p apps/game-client/tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings=300",
    "lint:strict": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "pnpm test:services:game:client",
    "test:coverage": "cross-env NODE_OPTIONS=--max-old-space-size=8192 jest --config jest.config.cjs --runInBand --passWithNoTests --coverage",
    "test:services:game:client": "cross-env NODE_OPTIONS=--max-old-space-size=8192 jest --config ./jest.config.cjs --runInBand --passWithNoTests",
    "test:services:server": "pnpm --filter services-server test",
    "format": "pnpm -r run format",
    "build:types": "pnpm build:types:global && pnpm build:types:server && pnpm build:types:client",
    "build:types:global": "pnpm --filter @shatteredarchive/types-global build",
    "build:types:server": "pnpm --filter @shatteredarchive/types-server build",
    "build:types:client": "pnpm --filter @shatteredarchive/types-client build",
    "build:utils": "",
    "build:utils:client": "",
    "build:utils:server": "",
    "dev": "concurrently \"pnpm dev:web-server\" \"pnpm dev:game-server\" \"pnpm dev:web-client\" \"pnpm dev:game-client\"",
    "start": "concurrently \"pnpm start:web-server\" \"pnpm start:game-server\" \"pnpm start:web-client\" \"pnpm start:game-client\"",
    "dev:web-client": "pnpm --filter @shatteredarchive/web-client dev",
    "dev:web-server": "pnpm --filter @shatteredarchive/web-server dev",
    "dev:game-client": "pnpm --filter @shatteredarchive/game-client dev",
    "dev:game-server": "pnpm --filter @shatteredarchive/game-server dev",
    "dev:kingdom-tactics-client": "pnpm --filter @shatteredarchive/kingdom-tactics-client dev",
    "dev:kingdom-tactics-server": "pnpm --filter @shatteredarchive/kingdom-tactics-server dev",
    "start:web-client": "pnpm --filter @shatteredarchive/web-client preview",
    "start:web-server": "pnpm --filter @shatteredarchive/web-server preview",
    "start:game-client": "pnpm --filter @shatteredarchive/game-client preview",
    "start:game-server": "pnpm --filter @shatteredarchive/game-server preview",
    "start:kingdom-tactics-client": "pnpm --filter @shatteredarchive/kingdom-tactics-client preview",
    "start:kingdom-tactics-server": "pnpm --filter @shatteredarchive/kingdom-tactics-server start",
    "dev:mud-builder-client": "pnpm --filter @shatteredarchive/mud-builder-client dev",
    "dev:mud-builder-server": "pnpm --filter @shatteredarchive/mud-builder-server dev",
    "start:mud-builder-client": "pnpm --filter @shatteredarchive/mud-builder-client preview",
    "start:mud-builder-server": "pnpm --filter @shatteredarchive/mud-builder-server start",
    "dev:psd-viewer": "concurrently \"pnpm dev:psd-viewer-client\" \"pnpm dev:psd-viewer-server\"",
    "dev:psd-viewer-client": "pnpm --filter @shatteredarchive/psd-viewer-client dev",
    "dev:psd-viewer-server": "pnpm --filter @shatteredarchive/psd-viewer-server dev",
    "start:psd-viewer-client": "pnpm --filter @shatteredarchive/psd-viewer-client preview",
    "start:psd-viewer-server": "pnpm --filter @shatteredarchive/psd-viewer-server start",
    "dev:scrum-poker": "concurrently \"pnpm dev:scrum-poker-server\" \"pnpm dev:scrum-poker-client\"",
    "dev:scrum-poker-client": "pnpm --filter @shatteredarchive/scrum-poker-client dev",
    "dev:scrum-poker-server": "pnpm --filter @shatteredarchive/scrum-poker-server dev",
    "start:scrum-poker-client": "pnpm --filter @shatteredarchive/scrum-poker-client preview",
    "start:scrum-poker-server": "pnpm --filter @shatteredarchive/scrum-poker-server start",
    "dev:auth-server": "pnpm --filter @shatteredarchive/auth-server dev",
    "start:auth-server": "pnpm --filter @shatteredarchive/auth-server start",
    "dev:auth-client": "pnpm --filter @shatteredarchive/auth-client dev",
    "start:auth-client": "pnpm --filter @shatteredarchive/auth-client preview",
    "start:oauth": "concurrently \"pnpm start:auth-client\" \"pnpm start:auth-server\"",
    "generate-master-key": "node scripts/generate-master-key.cjs",
    "setup:hosts:nix": "chmod +x deploy/scripts/add-hosts.sh && ./deploy/scripts/add-hosts.sh",
    "remove:hosts:nix": "chmod +x deploy/scripts/remove-hosts.sh && ./deploy/scripts/remove-hosts.sh",
    "setup:hosts:win": "powershell -ExecutionPolicy Bypass -File .\\deploy\\scripts\\add-hosts.ps1",
    "remove:hosts:win": "powershell -ExecutionPolicy Bypass -File .\\deploy\\scripts\\remove-hosts.ps1",
    "setup:certs": "node -e \"process.platform==='win32' ? require('child_process').execSync('powershell -ExecutionPolicy Bypass -File deploy/scripts/setup-certs.ps1', {stdio:'inherit'}) : require('child_process').execSync('bash deploy/scripts/setup-certs.sh', {stdio:'inherit'})\"",
    "dev:docker": "pnpm setup:certs && docker compose -f deploy/docker-compose.yml up -d --build",
    "firewall:open:ports": "node -e \"process.platform==='win32' ? require('child_process').execSync('powershell -ExecutionPolicy Bypass -File deploy/scripts/firewall-open-ports.ps1 prod', {stdio:'inherit'}) : require('child_process').execSync('bash deploy/scripts/firewall-open-ports.sh prod', {stdio:'inherit'})\""
  },
  "paths": {
    "@docs/*": [
      "./docs/*"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "cors": "^2.8.6",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "prettier": "^3.8.4",
    "ts-jest": "^29.4.11",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.61.1"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.8.0+sha512.c1f5e7c4cb241c8f174b743851d82f42b802324afc8b0f116b96adb15aa06664948dde36960a3ba1079ba5b4b29dd0140135b94b5b5f5263592249d68e555f26",
  "dependencies": {
    "concurrently": "^9.2.3"
  }
}
