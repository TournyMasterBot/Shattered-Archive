{
  "name": "shatteredarchive",
  "version": "1.0.0",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "build": "tsc",
    "clean": "tsc --build --clean",
    "start": "concurrently \"npm run start:web-server:dev\" \"npm run start:web-client:dev\" \"npm run start:game-server:dev\" \"npm run start:game-client:dev\"",
    "start:prod": "concurrently \"npm run start:web-server:prod\"  \"npm run start:web-client:prod\" \"npm run start:game-server:prod\" \"npm run start:game-client:prod\"",
    "start:web-server:dev": "npm --prefix ./src/web-server run start:dev",
    "start:web-server:prod": "npm --prefix ./src/web-server run start:prod",
    "start:web-client:dev": "npm --prefix ./src/web-client run start:dev",
    "start:web-client:prod": "npm --prefix ./src/web-client run start:prod",
    "start:game-server:dev": "npm --prefix ./src/game-server run start:dev",
    "start:game-server:prod": "npm --prefix ./src/game-server run start:prod",
    "start:game-client:dev": "npm --prefix ./src/game-client run start:dev",
    "start:game-client:prod": "npm --prefix ./src/game-client run start:prod",
    "test": "npx jest --config jest.config.js",
    "lint": "eslint \"**/*.ts\"",
    "lint:fix": "eslint \"**/*.ts\" --fix"
  },
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.0.8",
    "@typescript-eslint/eslint-plugin": "^8.24.0",
    "@typescript-eslint/parser": "^8.24.0",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.3",
    "nodemon": "^3.1.9",
    "prettier": "^3.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "jest": "^29.7.0",
    "jsonc-parser": "^3.3.1",
    "react-router-dom": "^7.1.5",
    "ts-jest": "^29.2.5"
  }
}
