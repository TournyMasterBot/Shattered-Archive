{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "node",
    "jsx": "react-jsx",

    "lib": ["DOM", "ES2022"],
    "types": ["jest"],

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "noEmit": true,

    "paths": {
      "@shatteredarchive/types-client": ["./types/types-client/src/index.ts"],
      "@shatteredarchive/types-global": ["./types/types-global/src/index.ts"],
      "@shatteredarchive/utils-client": ["./utils/utils-client/src/index.ts"],
      "@shatteredarchive/utils-client/*": ["./utils/utils-client/src/*"],
      "@shatteredarchive/utils-global": ["./utils/utils-global/src/index.ts"]
    }
  }
}
