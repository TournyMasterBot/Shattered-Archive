# ============================================================
# Cert Files
# ============================================================
**/*.pem

# ============================================================
# Environment Files
# ============================================================
.env.*
!.env.dev
!.env.docker

# ============================================================
# TypeScript
# ============================================================
*.tsbuildinfo

# ============================================================
# Misc
# ============================================================
.secrets
coverage/*
@personal-notes/
@personal-notes/*
@dsl-data/*
*.js.map
*.js
!jest.config.js
!meta-scripts/**/*.js
jwt-secret.dat

# auth-server: per-app encrypted JSON stores, and the private key files that
# services calling /api/introspect hold on their OWN host (Phase 2) — never commit.
apps/auth-server/data/*
!apps/auth-server/data/.gitkeep
!apps/auth-server/data/dsl-questions.example.json
shattered-service.key

# kingdom-tactics-server: per-account match-history/replay + army-layout JSON stores (Phase F).
apps/kingdom-tactics-server/data/*
!apps/kingdom-tactics-server/data/.gitkeep

# scrum-poker-server: rooms.json holds live room state INCLUDING each room's host token —
# the one secret in this otherwise accounts-free app. Local dev writes it here; the deployed
# stack keeps it on the scrum-poker-data named volume.
apps/scrum-poker-server/data/*
!apps/scrum-poker-server/data/.gitkeep

# ============================================================
# Logs
# ============================================================
**/logs/
**/logs/*
**/log/
**/log/*
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ============================================================
# Node.js / pnpm
# ============================================================
node_modules/
.pnpm-store/
.pnp.*
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# ============================================================
# Build Output (all workspace packages)
# ============================================================
dist/
build/
out/
coverage/

# ============================================================
# OS-specific Files
# ============================================================
.DS_Store
Thumbs.db
desktop.ini

# ============================================================
# Editor directories and files
# ============================================================
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ============================================================
# Test / Coverage Tools
# ============================================================
.nyc_output/
.jest/
.claude/settings.local.json
.claude/settings.json

# ============================================================
# Security Updates (fetched Dependabot data — not committed)
# ============================================================
.security-updates/*
!.security-updates/.gitkeep
