{
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024"],
    "jsx": "react",
    "module": "commonjs",
    "rootDir": "./",
    "moduleResolution": "node",
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "noFallthroughCasesInSwitch": true,
    "rootDirs": [
      "./src/web-server",
      "./src/web-client",
      "./src/game-server",
      "./src/game-client",
      "./src/shared"
    ],
    "baseUrl": ".",
    "paths": {
      "@web-server/*": ["./src/web-server"],
      "@web-client/*": ["./src/web-client"],
      "@game-server/*": ["./src/game-server"],
      "@game-client/*": ["./src/game-client"],
      "@shared/*": ["./src/shared/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules"]
}
