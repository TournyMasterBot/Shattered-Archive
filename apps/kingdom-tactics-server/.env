ENVIRONMENT=dev
PORT=51000
LOG_FILE_PATH=./log/server.log
JSON_LOG_FILE_PATH=./log/server.log.jsonl

# Phase 3 (centralized auth service): only used by the host-only `introspect-check` script
# (pnpm --filter @shatteredarchive/kingdom-tactics-server introspect-check <token>) — never
# required for the server to run. SERVICE_PRIVATE_KEY_PATH is this service's own registered
# key from `pnpm --filter @shatteredarchive/auth-server register-service kingdom-tactics-server`
# (git-ignored by auth-server's exact-filename .gitignore pattern).
# AUTH_SERVER_URL=http://localhost:62000
# SERVICE_PRIVATE_KEY_PATH=./shattered-service.key
