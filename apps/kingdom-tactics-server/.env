ENVIRONMENT=dev
PORT=51000
LOG_FILE_PATH=./log/server.log
JSON_LOG_FILE_PATH=./log/server.log.jsonl

# Phase F: per-account match-history/replay + army-layout JSON stores.
DATA_DIR=./data

# Phase F: this service's own registered Ed25519 key (real registration done
# 2026-07-27 via `pnpm --filter @shatteredarchive/auth-server register-service
# kingdom-tactics-server` — an EARLIER version of this comment falsely claimed
# this was already done; verified via a live ServiceKeyStore.listServices()
# call that it was not, before registering for real). Used at runtime by the
# WS `join`-frame token introspection (kt-gateway.ts) and the login callback's
# code exchange, not just introspect-check. shattered-service.key is
# git-ignored by the root .gitignore's exact-filename pattern.
#
# auth-server's container port (62000) is NOT published to the host — only
# reachable from other containers on its docker network. This service runs
# via bare `pnpm dev` on the host until Phase F Step 4 dockerizes it, so the
# LOCAL DEV default below points at the public edge instead
# (auth.shatteredarchive.dev via nginx + the dev machine's hosts-file entry).
# The docker-compose entry added in Step 4 overrides this to the internal
# alias (http://auth-server.shatteredarchive.dev:62000, no TLS), matching
# mud-builder-server's proven pattern. The dev TLS cert is only trusted via
# the system CA store, not Node's default bundle — that's why `dev`/`start`/
# `introspect-check` all run under NODE_OPTIONS=--use-system-ca (package.json).
AUTH_SERVER_URL=https://auth.shatteredarchive.dev
# AUTH_SERVER_PUBLIC_URL is unset here on purpose — it falls back to AUTH_SERVER_URL above,
# which is correct for local dev (both the browser redirect and the server-to-server exchange
# hit the same public edge). The docker-compose entry overrides AUTH_SERVER_URL to the internal
# alias and sets AUTH_SERVER_PUBLIC_URL explicitly to the public edge, so the two only diverge
# there.
SERVICE_PRIVATE_KEY_PATH=./shattered-service.key

# Phase F Step 3: kt-client's own origin — the ONLY allowed `returnUrl` origin
# for /api/kt/auth/start's browser hand-off. Comma-separated if ever more than
# one (there isn't, today).
KT_CLIENT_ALLOWED_RETURN_ORIGINS=http://localhost:50080
