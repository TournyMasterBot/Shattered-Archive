{
  "name": "@shatteredarchive/shattered-maps-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shattered-Maps: the map editor and viewer for the game (moved here from the DslMapper repository)",
  "scripts": {
    "dev": "vite",
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=4096 vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --max-warnings=5",
    "test": "jest --config ./jest.config.cjs --runInBand --passWithNoTests",
    "format": "prettier --write \"src/**/*.{ts,tsx,scss,css}\""
  },
  "dependencies": {
    "@shatteredarchive/shattered-maps-core": "workspace:*",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "cross-env": "^10.1.0",
    "sass-embedded": "^1.108.2",
    "vite": "^8.3.8"
  }
}
