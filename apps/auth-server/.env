ENVIRONMENT=dev
PORT=62000
DATA_DIR=./data

# LOCAL DEV override only — 64 hex chars (32 bytes). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Leave unset in any deployed environment; DATA_ENCRYPTION_KEY_FILE below is used instead.
DATA_ENCRYPTION_KEY=

# Deploy path — the file a mounted secret volume provides (see deploy/docker-compose*.yml).
# Self-generated on first boot if the file is absent but its parent directory exists.
# Blank/commented for bare local dev, where DATA_ENCRYPTION_KEY above is used instead.
# DATA_ENCRYPTION_KEY_FILE=/repo/apps/auth-server/secrets/encryption.key

# Unused by auth-server itself — documented here only because it's the convention Phase 2
# consumers (services calling /api/introspect) will read on their OWN host. Leave blank/commented.
# SERVICE_PRIVATE_KEY_PATH=

# Blank = console mail transport (prints the link instead of sending).
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

PUBLIC_ORIGIN=http://localhost:62080

# Origins allowed to call /api/device with credentials (device-bound credentials).
# Local dev values: the client dev servers that enroll a device key. Cross-origin here
# because they run on different PORTS than auth-server (62000) — but the session cookie
# still arrives, since cookies are not port-scoped. Note localhost and 127.0.0.1 are
# DIFFERENT origins to a browser: add the 127.0.0.1 form too if you browse that way.
# Exact match, lowercase, no path, no default port. Empty = deny all.
#
# `origin=service` — the service each origin may mint device tokens for, mirroring the
# origin → upstream routing nginx performs in a real deployment. The CORS allowlist is
# derived from these keys, so listing an origin here is what permits it to enroll.
# Use `origin=svc1|svc2` when one origin talks to several backends.
DEVICE_ORIGIN_SERVICES=http://localhost:60080=mud-builder-server,http://localhost:50080=kingdom-tactics-server
# Services that also require an active API key on the account before a device may mint for
# them. Empty = none. Set to mud-builder-server to make authoring access an explicit grant.
DEVICE_GRANT_REQUIRED_SERVICES=
