ENVIRONMENT=dev
PORT=61000
LOG_FILE_PATH=./log/server.log
JSON_LOG_FILE_PATH=./log/server.log.jsonl
MERC_MUD_PATH=C:/Projects/merc-mud
MERC_AREA_DIR=2.4/area
# Disk writes to the MUD folders are gated OFF by default (preview/download only).
# Set to true ONLY deliberately (experimental compose sets this; local staging E2E may too).
# MUD_WRITE_ENABLED=true

# Phase 4 (centralized auth service): authGuard's introspect fallback for any bearer token
# unrecognized by the local builder-auth.json store. Also used by the additive, master-only
# GET /api/auth/introspect-check proof-of-mechanism route (Phase 2). Neither is required for
# the builder to run — with both unset, behavior is unchanged from before Phase 2/4.
# SERVICE_PRIVATE_KEY_PATH is this service's own registered key from
# `pnpm --filter @shatteredarchive/auth-server register-service mud-builder-server`
# (git-ignored by the auth-server's exact-filename .gitignore pattern).
# AUTH_SERVER_URL=http://localhost:62000
# SERVICE_PRIVATE_KEY_PATH=./shattered-service.key
