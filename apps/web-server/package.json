{
  "name": "@shatteredarchive/web-server",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "jest --config ../../jest.config.cjs --runInBand --rootDir .",
