													"    console.error(\"Error fetching CSRF token:\", err);\r",
													"  } else {\r",
													"    const json = res.json();\r",
													"    // Save the token to an environment variable\r",
													"    pm.environment.set(\"csrfToken\", json.token);\r",
													"    console.log(\"CSRF Token fetched:\", json.token);\r",
													"  }\r",
													"});"
												],
												"type": "text/javascript",
												"packages": {}
											}
