{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    // Tests (and the dev-time codegen) may use jest + node APIs.
    "types": ["jest", "node"],

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "noEmit": true
  }
}
