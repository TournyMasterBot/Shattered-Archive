{
  "name": "@shatteredarchive/kingdom-tactics-engine",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "jest --config ./jest.config.cjs --runInBand --passWithNoTests",
    "codegen": "tsx src/codegen/generate-dsl-data.ts && tsx src/codegen/generate-dsl-attributes.ts",
    "codegen:attrs": "tsx src/codegen/generate-dsl-attributes.ts",
    "format": "prettier --write \"src/**/*.{ts,json}\""
  },
  "dependencies": {
    "@shatteredarchive/types-global": "workspace:*",
    "@shatteredarchive/utils-global": "workspace:*"
  }
}
